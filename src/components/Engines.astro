---
import { Icon } from "astro-icon/components";
import { section } from "../lib/content";

const engines = await section("engines");
---

<section aria-label={engines.title} class="border-y border-line/70 bg-surface/50">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-12 gap-y-6 px-4 py-8 sm:px-6 md:justify-between">
    <h2 class="text-sm text-muted">{engines.title}</h2>
    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-5">
      {
        engines.items.map((e) => (
          <li class="flex items-center gap-2.5 text-muted">
            <Icon name={e.icon} class="size-6" aria-hidden="true" />
            <span class="text-sm font-medium text-fg/85">{e.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
