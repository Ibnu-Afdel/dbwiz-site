---
import { Icon } from "astro-icon/components";
import { section, inline } from "../lib/content";

const f = await section("faq");
---

<section id="faq" class="mx-auto grid max-w-6xl gap-10 px-4 py-24 sm:px-6 md:py-28 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
  <h2 class="reveal text-3xl leading-tight font-semibold tracking-tight md:text-4xl lg:sticky lg:top-28 lg:self-start">{f.title}</h2>
  <div class="divide-y divide-line border-y border-line">
    {
      f.items.map((item) => (
        <details class="group reveal">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium [&::-webkit-details-marker]:hidden">
            {item.q}
            <Icon name="ph:plus" class="size-4 shrink-0 text-muted transition-transform duration-300 group-open:rotate-45" aria-hidden="true" />
          </summary>
          <p class="prose-inline max-w-[62ch] pb-6 leading-relaxed text-muted" set:html={inline(item.a)} />
        </details>
      ))
    }
  </div>
</section>
