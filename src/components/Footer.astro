---
import { section } from "../lib/content";

const f = await section("footer");
---

<footer class="border-t border-line/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3">
      <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
      <div>
        <p class="font-semibold">{f.title}</p>
        <p class="text-sm text-muted">{f.tagline}</p>
      </div>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
      {f.links.map((l) => <li><a href={l.href} class="transition-colors hover:text-fg">{l.label}</a></li>)}
    </ul>
  </div>
  <p class="mx-auto max-w-6xl px-4 pb-10 text-xs text-muted sm:px-6">
    MIT licensed. Made by <a href="https://github.com/Ibnu-Afdel" class="underline-offset-2 hover:underline">Ibnu Afdel</a>.
  </p>
</footer>
