---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Features", href: "#features" },
  { label: "Omarchy", href: "#omarchy" },
  { label: "Install", href: "#install" },
  { label: "FAQ", href: "#faq" },
];
---

<header class="sticky top-0 z-20 border-b border-line/60 bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="28" height="28" class="size-7" />
      DBWiz
    </a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-fg">{l.label}</a></li>)}
    </ul>
    <a href="https://github.com/Ibnu-Afdel/dbWiz" class="btn btn-ghost !py-1.5 text-sm">
      <Icon name="ph:github-logo" class="size-4" aria-hidden="true" />
      GitHub
    </a>
  </nav>
</header>
