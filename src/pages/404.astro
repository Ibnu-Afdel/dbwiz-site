---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Not found | DBWiz">
  <Nav />
  <main class="mx-auto flex min-h-[70dvh] max-w-xl flex-col items-start justify-center px-4 sm:px-6">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Nothing at this address.</h1>
    <p class="mt-4 text-muted">The page moved or never existed. The whole site is one page.</p>
    <a href="/" class="btn btn-primary mt-8">Back to DBWiz</a>
  </main>
</Layout>
