{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static site: Cloudflare serves the Astro build straight from its edge, with
  // no Worker script. Unknown paths get dist/404.html with a real 404 status.
  "name": "dbwiz-site",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "dbwiz.ibnuafdel.com", "custom_domain": true }]
}
